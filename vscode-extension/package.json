{
  "name": "senran-vscode",
  "displayName": "森蚺 (Senran) — 文言 Python 智囊輔助",
  "description": "以文言驅策萬象 Python 函式庫：提供古典詞律智慧補全、懸停解經與常用代碼片段",
  "version": "0.1.0",
  "publisher": "sucryan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "senran",
    "wenyan",
    "python",
    "classical-chinese",
    "snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:senran"
  ],
  "contributes": {
    "languages": [
      {
        "id": "senran",
        "aliases": ["Senran", "森蚺", "文言Python"],
        "extensions": [".sr", ".senran"]
      }
    ],
    "grammars": [
      {
        "language": "senran",
        "scopeName": "source.senran",
        "path": "./syntaxes/senran.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "senran.transcribe",
        "title": "🐍 森蚺：一鍵化俗為雅（轉錄為文言代碼）",
        "category": "森蚺 (Senran)"
      },
      {
        "command": "senran.formatPianwen",
        "title": "📜 森蚺：賦體排版（化為 .sr 駢儷文章）",
        "category": "森蚺 (Senran)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "senran.transcribe",
          "when": "editorTextFocus && (resourceExtname == .py || resourceExtname == .sr || resourceExtname == .senran)",
          "group": "senran@1"
        },
        {
          "command": "senran.formatPianwen",
          "when": "editorTextFocus && (resourceExtname == .py || resourceExtname == .sr || resourceExtname == .senran)",
          "group": "senran@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "senran.transcribe",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus"
      },
      {
        "command": "senran.formatPianwen",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "senran",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sucryan/senran"
  }
}
