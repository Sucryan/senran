{
  "name": "senran-vscode",
  "displayName": "森蚺 (Senran) — 文言 Python 智囊輔助",
  "description": "以文言驅策萬象 Python 函式庫：提供古典詞律智慧補全、懸停解經與常用代碼片段",
  "version": "0.1.8",
  "publisher": "sucryan",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "senran",
    "wenyan",
    "python",
    "classical-chinese",
    "snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:senran",
    "onCommand:senran.transcribe",
    "onCommand:senran.toZhpy",
    "onCommand:senran.formatPianwen",
    "onCommand:senran.toStandardPy",
    "onCommand:senran.runFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "senran",
        "aliases": [
          "Senran",
          "森蚺",
          "文言Python"
        ],
        "extensions": [
          ".sr",
          ".senran"
        ]
      }
    ],
    "grammars": [
      {
        "language": "senran",
        "scopeName": "source.senran",
        "path": "./syntaxes/senran.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "senran.runFile",
        "title": "森蚺：吟詠當前文卷（執行）",
        "category": "森蚺 (Senran)"
      },
      {
        "command": "senran.toZhpy",
        "title": "🗣️ 森蚺：轉換成周蟒（白話中文代碼）",
        "category": "森蚺 (Senran)"
      },
      {
        "command": "senran.transcribe",
        "title": "🐍 森蚺：一鍵化俗為雅（轉錄為文言代碼）",
        "category": "森蚺 (Senran)"
      },
      {
        "command": "senran.toStandardPy",
        "title": "💻 森蚺：一鍵化雅為俗（逆轉為標準西邦代碼）",
        "category": "森蚺 (Senran)"
      },
      {
        "command": "senran.formatPianwen",
        "title": "📜 森蚺：賦體排版（化為 Markdown 駢儷文章）",
        "category": "森蚺 (Senran)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "senran.toZhpy",
          "when": "editorTextFocus && (resourceLangId == python || resourceLangId == senran || resourceLangId == markdown)",
          "group": "navigation@0"
        },
        {
          "command": "senran.transcribe",
          "when": "editorTextFocus && (resourceLangId == python || resourceLangId == senran || resourceLangId == markdown)",
          "group": "navigation@1"
        },
        {
          "command": "senran.toStandardPy",
          "when": "editorTextFocus && (resourceLangId == python || resourceLangId == senran || resourceLangId == markdown)",
          "group": "navigation@2"
        },
        {
          "command": "senran.formatPianwen",
          "when": "editorTextFocus && (resourceLangId == python || resourceLangId == senran || resourceLangId == markdown)",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "senran.runFile",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == senran"
      },
      {
        "command": "senran.transcribe",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus"
      },
      {
        "command": "senran.toStandardPy",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "senran.formatPianwen",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "senran",
        "path": "./snippets/snippets.json"
      }
    ],
    "configuration": {
      "title": "森蚺",
      "properties": {
        "senran.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "已安裝 senran 的 Python 執行檔路徑。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sucryan/senran"
  }
}
